{
  // NovaPortal instance config for this site. The NovaPortal CLI materialises
  // this into a full wrangler config (injecting worker entry + migrations
  // paths) at build/deploy time — see the novaportal repo's registry.json.
  "name": "novaportal-explorebowland",
  "apps": ["redirects", "chat"],
  // CI shape for `novaportal wire`: how builds get the read token + rebuilds.
  "ci": { "kind": "pages", "pagesProject": "explorebowland", "branch": "claude/astro-blog-migration-strategy-rzq6pq" },
  "compatibility_date": "2025-05-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novaportal-explorebowland",
      "database_id": "ba4ace2c-22aa-4104-ac7b-9cc58ed023d4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "novaportal-explorebowland-media"
    }
  ],
  "vars": {
    "SITE_NAME": "Explore Bowland",
    "SITE_URL": "https://www.explorebowland.co.uk",
    "LEAD_TO_EMAIL": "jack1999adams@gmail.com",
    "LEAD_FROM_EMAIL": "onboarding@resend.dev",
    // Portal-editable theme tokens. `cssVar` must exist in src/styles/global.css
    // and `default` must match its current value byte-for-byte (the portal only
    // emits CSS for values that differ from the default).
    "THEME_SCHEMA": [
      { "key": "green",     "label": "Accent green",            "type": "color", "cssVar": "--green",     "default": "#8bba34" },
      { "key": "green_ink", "label": "Link & heading green",    "type": "color", "cssVar": "--green-ink", "default": "#5f8021" },
      { "key": "navy",      "label": "Navy (header/footer)",    "type": "color", "cssVar": "--navy",      "default": "#001d39" },
      { "key": "gold",      "label": "Gold highlight",          "type": "color", "cssVar": "--gold",      "default": "#e0b13a" },
      { "key": "ink",       "label": "Body text",               "type": "color", "cssVar": "--ink",       "default": "#23281d" },
      { "key": "paper_2",   "label": "Soft section background", "type": "color", "cssVar": "--paper-2",   "default": "#f7f8f4" },
      { "key": "font_sans", "label": "Body font",               "type": "font",  "cssVar": "--font-sans", "default": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif" },
      { "key": "font_head", "label": "Heading font",            "type": "font",  "cssVar": "--font-head", "default": "var(--font-sans)" }
    ],
    // Per-post route-info custom fields for walk posts. The site renders these
    // as the Route panel (src/lib/route-schema.mjs mirrors this list). Values
    // are delivered per post in the content API's `extras` keyed by `key`; blank
    // fields are omitted from the panel.
    "ROUTE_SCHEMA": [
      { "key": "distance",      "label": "Distance",      "type": "text" },
      { "key": "difficulty",    "label": "Difficulty",    "type": "text" },
      { "key": "low_point",     "label": "Low point",     "type": "text" },
      { "key": "high_point",    "label": "High point",    "type": "text" },
      { "key": "ascent",        "label": "Total ascent",  "type": "text" },
      { "key": "steps",         "label": "Steps",         "type": "text" },
      { "key": "calories",      "label": "Calories",      "type": "text" },
      { "key": "postcode",      "label": "Postcode",      "type": "text" },
      { "key": "map_reference", "label": "Map reference", "type": "text" },
      { "key": "cows",          "label": "Cows",          "type": "text" },
      { "key": "bogs",          "label": "Bogs",          "type": "text" },
      { "key": "dogs",          "label": "Dogs",          "type": "text" },
      { "key": "nearby_pub",    "label": "Nearby pub",    "type": "text" },
      { "key": "nearby_hotel",  "label": "Nearby hotel",  "type": "text" },
      { "key": "links",         "label": "Links",         "type": "text" },
      { "key": "gpx",           "label": "Download GPX",  "type": "file", "accept": ".gpx" }
    ],
    // Page templates this site implements (portal Pages picker + fields).
    // Rendered by src/components/PageRender.astro via the [...slug] catch-all.
    "PAGE_TEMPLATES": [
      { "key": "standard", "label": "Standard page", "description": "Hero heading, optional image, and rich text — for info and about pages.", "fields": [] },
      {
        "key": "landing", "label": "Landing page",
        "description": "Hero band with heading, intro and a call-to-action button, then rich content.",
        "fields": [
          { "key": "hero_heading", "label": "Hero heading", "type": "text" },
          { "key": "hero_subheading", "label": "Hero intro", "type": "textarea" },
          { "key": "cta_label", "label": "Button label", "type": "text" },
          { "key": "cta_href", "label": "Button link", "type": "text" }
        ]
      }
    ]
  },
  // Secrets (per instance, set via wrangler): SETUP_TOKEN, READ_TOKEN,
  // DEPLOY_HOOK_URL (native Pages hook)
  "observability": { "enabled": true }
}
