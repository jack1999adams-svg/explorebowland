# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# --- Cloudflare R2 (image storage) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=explorebowland-images
# Public CDN base for the bucket (custom domain bound in Cloudflare):
R2_PUBLIC_BASE=https://images.explorebowland.co.uk

# --- Import-time image rewriting ---
# When set, the WordPress importer rewrites wp-content/uploads URLs to this base
# so imported content points at R2 instead of the old site.
# Leave unset to keep original URLs while developing.
# IMAGE_CDN_BASE=https://images.explorebowland.co.uk

# --- Legacy migration (scripts/migrate-images.mjs) ---
# UPLOADS_DIR=./uploads-raw     # local copy of wp-content/uploads
# REFERENCED_ONLY=1             # 1 = only images used by content (default), 0 = all originals
# CONCURRENCY=6
