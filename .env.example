# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# --- NovaPortal (content source) ---
# Read token for build-time post fetch. Required for `npm run build`.
# Also set as a Cloudflare Pages environment variable for production builds.
NOVAPORTAL_READ_TOKEN=your-novaportal-read-token

# --- Image base (R2) ---
# R2 public base URL. Migrated images keep their wp-content/uploads/... path,
# so the site swaps the WordPress origin for this one at build time.
# The NovaPortal loader (posts) and index.astro (curated images) read IMAGE_BASE;
# the WordPress importer (pages) reads IMAGE_CDN_BASE = IMAGE_BASE/wp-content/uploads.
IMAGE_BASE=https://pub-9875a2c5cc9242d09206ca6d03efaa3b.r2.dev
# IMAGE_CDN_BASE=https://pub-9875a2c5cc9242d09206ca6d03efaa3b.r2.dev/wp-content/uploads

# --- Cloudflare R2 (image storage / migration + portal uploads) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=novaportal-explorebowland-media
R2_PUBLIC_BASE=https://pub-9875a2c5cc9242d09206ca6d03efaa3b.r2.dev

# --- Referenced-image migration (scripts/migrate-referenced-images.mjs) ---
# MAX_DIM=2048        # cap longest side
# IMG_QUALITY=80
# CONCURRENCY=8
# LIMIT=20            # process only the first N (testing)

# --- Full-archive migration from SFTP pull (scripts/migrate-images.mjs) ---
# UPLOADS_DIR=./uploads-raw     # local copy of wp-content/uploads
# REFERENCED_ONLY=1             # 1 = only images used by content (default), 0 = all originals
