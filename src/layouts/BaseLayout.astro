---
import '../styles/global.css';
import '../styles/content.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import { organization, website } from '../lib/schema.mjs';
import { themeCss, headHtmlFor } from '../lib/theme.mjs';

// Consent + Google Consent Mode v2 are handled by CookieYes (a Google-certified
// CMP), injected via the portal head snippet (see headHtmlFor below). Load the
// CookieYes tag first in that snippet so its consent defaults are set before any
// analytics/ads (GA, AdSense) tags fire.

interface Props {
  title: string;
  description?: string;
  /** Exact canonical path, e.g. "/caton-moor/" — preserves legacy URLs. */
  path?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** ISO dates for articles — emitted as article:published_time / modified_time. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Page-specific JSON-LD nodes (breadcrumbs, article, recipe, place…). */
  jsonLd?: any[];
  /** Keep the page out of search indexes (e.g. the /nova-preview/ templates). */
  noindex?: boolean;
}
const {
  title,
  description = '',
  path,
  image,
  imageAlt = '',
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd = [],
  noindex = false,
} = Astro.props;
const siteName = 'Explore Bowland';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;

// Organization + WebSite are emitted on every page; pages add their own nodes.
const schema = [organization(), website(), ...jsonLd];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Hero and content images are served from R2 — warm the connection early. */}
    <link rel="preconnect" href="https://media.explorebowland.co.uk" crossorigin />
    <link rel="dns-prefetch" href="https://media.explorebowland.co.uk" />

    {/* Favicons — the hen harrier from the logo. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}
    <meta name="theme-color" content="#001d39" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && (modifiedTime || publishedTime) && (
      <meta property="article:modified_time" content={modifiedTime || publishedTime} />
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <Schema items={schema} />

    {/* Portal-edited theme overrides (empty until the client saves values). */}
    {themeCss && <Fragment set:html={`<style>${themeCss}</style>`} />}
    {/* Portal-managed head snippets, filtered to this page by their scope. */}
    {headHtmlFor(Astro.url.pathname) && <Fragment set:html={headHtmlFor(Astro.url.pathname)} />}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/*
      Portal-managed chat assistant. Served from the portal, so widget fixes
      never need a site rebuild. Renders nothing until the chat is switched on
      with an API key in the portal — until then it's one cached request.
    */}
    <script src="https://novaportal-explorebowland.collectiq.workers.dev/api/c/chat/widget.js" defer></script>
  </body>
</html>
