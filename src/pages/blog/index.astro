---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, toCard } from '../../lib/content';
import { abs, breadcrumbs } from '../../lib/schema.mjs';

// The Journal: non-walk posts (trips, days out, the odd recipe). Walk guides now
// live in the Bowland Walks / Other Walks sections. Matches posts whose category
// parent is this page (/blog/), like every other section page.
const posts = (await getPosts()).filter((p) => p.data.sectionParent === '/blog/');

const jsonLd = [
  breadcrumbs([
    { name: 'Home', url: abs('/') },
    { name: 'Journal', url: abs('/blog/') },
  ]),
];
---

<BaseLayout
  title="Journal"
  description="Trips, days out and the occasional recipe from around the Forest of Bowland and beyond."
  path="/blog/"
  jsonLd={jsonLd}
>
  <header class="hero plain">
    <div class="container">
      <p class="eyebrow">Explore Bowland</p>
      <h1>Journal</h1>
      <p class="lead">Trips, days out and the odd recipe from around the Forest of
        Bowland and further afield.</p>
    </div>
  </header>

  <section class="container section">
    <div class="grid">
      {posts.map((p) => <PostCard {...toCard(p)} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero.plain { background: var(--paper-2); border-bottom: 1px solid var(--line); }
  .hero.plain .container { padding-block: 3rem 2.5rem; }
  h1 { font-size: var(--step-4); margin: 0.3rem 0 0.3rem; }
  .lead { color: var(--ink-soft); margin: 0; max-width: 46ch; }
  .section { padding-block: 3rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
</style>
