---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleHero from '../components/ArticleHero.astro';
import PostCard from '../components/PostCard.astro';
import RoutePanel from '../components/RoutePanel.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getPosts, toCard } from '../lib/content';
import PageRender from '../components/PageRender.astro';
import { loadPages } from '../lib/pages.mjs';
import {
  abs,
  humanize,
  breadcrumbs,
  article,
  recipe,
  walkPlace,
} from '../lib/schema.mjs';

// Reproduce every legacy WordPress URL 1:1. Each entry carries its exact
// original permalink in `data.path`; we turn that into the catch-all slug so
// /caton-moor/ and /things-to-do/towns-and-villages/abbeystead/ both resolve.
export async function getStaticPaths() {
  const posts = await getCollection('posts', (e) => !e.data.draft);
  const pages = await getCollection('pages', (e) => !e.data.draft);
  const owned = new Set(['/', '/blog/', '/get-in-touch/']); // rendered by dedicated routes

  const make = (entry, kind) => {
    const p = entry.data.path;
    const slug = p.replace(/^\/|\/$/g, '');
    return { params: { slug }, props: { entry, kind } };
  };

  // Portal-managed pages win; the file-based `pages` collection is the fallback
  // for anything not yet in the portal (mirrors how posts already work).
  const portalPages = await loadPages();
  const portalPaths = new Set(portalPages.map((p) => p.path));

  return [
    ...posts.filter((e) => !owned.has(e.data.path)).map((e) => make(e, 'post')),
    ...pages
      .filter((e) => !owned.has(e.data.path) && !portalPaths.has(e.data.path))
      .map((e) => make(e, 'page')),
    ...portalPages
      .filter((p) => p.path && !owned.has(p.path) && !posts.some((e) => e.data.path === p.path))
      .map((p) => ({ params: { slug: p.path.replace(/^\/|\/$/g, '') }, props: { portalPage: p, kind: 'portalpage' } })),
  ];
}

const { entry, kind, portalPage } = Astro.props;

// Vars the template reads; filled per kind. Portal-managed pages carry
// pre-rendered HTML + a template and skip the post/page machinery below.
let Content, d, sectionPosts = [], sectionLabel = '', route = [], crumbs, jsonLd, published, modified;

if (kind === 'portalpage') {
  d = { title: portalPage.title, description: portalPage.description, path: portalPage.path, hero: portalPage.image, heroAlt: portalPage.imageAlt };
  crumbs = [
    { name: 'Home', url: abs('/') },
    ...(portalPage.ancestors ?? []).map((a) => ({ name: a.title, url: abs(a.path) })),
    { name: portalPage.title, url: abs(portalPage.path) },
  ];
  jsonLd = [breadcrumbs(crumbs)];
  // Section parents (e.g. /forest-of-bowland-walks/) list the posts assigned to
  // them — same as file-based section pages, so nothing regresses on import.
  sectionPosts = (await getPosts()).filter((p) => p.data.sectionParent === portalPage.path);
  sectionLabel = sectionPosts[0]?.data.sectionLabel || '';
} else {
  ({ Content } = await render(entry));
  d = entry.data;

  // If this page is the parent of a section (category), list that section's posts
  // after its content. The assignment lives in the portal (post.sectionParent) and
  // is matched to this page's exact path — so it self-updates when the client
  // reassigns a section. /blog/ is handled by its own index route.
  sectionPosts =
    kind === 'page' && d.path !== '/blog/'
      ? (await getPosts()).filter((p) => p.data.sectionParent === d.path)
      : [];
  sectionLabel = sectionPosts[0]?.data.sectionLabel || '';

  // Walk posts (Bowland / Other area walks) show a route-info panel in the right
  // column, populated from the portal's route custom fields (ROUTE_SCHEMA). The
  // panel appears once the client fills any field; blank fields are omitted. The
  // post body is never modified.
  const isWalk =
    kind === 'post' &&
    (d.categories?.includes('Bowland Walks') || d.categories?.includes('Other area walks'));
  route = isWalk ? d.route ?? [] : [];

  // ---- Structured data (JSON-LD) ----------------------------------------------
  const canonical = abs(d.path);
  const heroAbs = d.hero ? abs(d.hero) : undefined;
  const isRecipe = kind === 'post' && d.categories?.includes('Recipes');

  // Breadcrumb trail. Posts: Home → section → post (section comes straight from
  // the portal). Pages: walk the path segments, labelling each with its own page
  // title where we have one, else a humanised slug.
  const pageTitleByPath = new Map(
    (await getCollection('pages')).map((e) => [e.data.path, e.data.title]),
  );
  crumbs = [{ name: 'Home', url: abs('/') }];
  if (kind === 'post') {
    if (d.sectionParent && d.sectionLabel) {
      crumbs.push({ name: d.sectionLabel, url: abs(d.sectionParent) });
    }
    crumbs.push({ name: d.title, url: canonical });
  } else {
    const segs = d.path.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
    let acc = '';
    segs.forEach((seg, i) => {
      acc += `/${seg}`;
      const p = `${acc}/`;
      const last = i === segs.length - 1;
      crumbs.push({
        name: last ? d.title : pageTitleByPath.get(p) || humanize(seg),
        url: abs(p),
      });
    });
  }

  published = d.pubDate ? new Date(d.pubDate).toISOString() : undefined;
  modified = d.updatedDate ? new Date(d.updatedDate).toISOString() : undefined;
  const meta = { title: d.title, description: d.description, canonical, image: heroAbs };

  jsonLd = [breadcrumbs(crumbs)];
  if (kind === 'post') {
    jsonLd.push(
      isRecipe
        ? recipe({ ...meta, published })
        : article({ ...meta, published, modified }),
    );
    if (isWalk) jsonLd.push(walkPlace({ ...meta, route }));
  }
}
---

{kind === 'portalpage' ? (
  <BaseLayout title={d.title} description={d.description} path={d.path} image={d.hero} imageAlt={d.heroAlt} jsonLd={jsonLd}>
    <PageRender template={portalPage.template} title={portalPage.title} html={portalPage.html} image={portalPage.image} imageAlt={portalPage.imageAlt} extras={portalPage.extras} crumbs={crumbs} />
    {sectionPosts.length > 0 && (
      <section class="container section-list">
        <div class="section-head">
          <p class="eyebrow">In this section</p>
          <h2>{sectionLabel || 'Latest posts'} <span class="count">{sectionPosts.length}</span></h2>
        </div>
        <div class="grid">
          {sectionPosts.map((p) => <PostCard {...toCard(p)} />)}
        </div>
      </section>
    )}
  </BaseLayout>
) : (
<BaseLayout
  title={d.title}
  description={d.description}
  path={d.path}
  image={d.hero}
  imageAlt={d.heroAlt}
  type={kind === 'post' ? 'article' : 'website'}
  publishedTime={kind === 'post' ? published : undefined}
  modifiedTime={kind === 'post' ? modified : undefined}
  jsonLd={jsonLd}
>
  <ArticleHero
    title={d.title}
    hero={d.hero}
    heroAlt={d.heroAlt}
    pubDate={kind === 'post' ? d.pubDate : undefined}
    categories={kind === 'post' ? d.categories : []}
  />

  <article class="container">
    <Breadcrumbs crumbs={crumbs} />

    {route.length > 0 ? (
      <div class="walk-layout">
        <div class="prose walk-prose"><Content /></div>
        <RoutePanel route={route} />
      </div>
    ) : (
      <div class="prose">
        <Content />
      </div>
    )}

    {kind === 'post' && (
      <p class="back">
        <a href={d.sectionParent || '/'}>← Back to {d.sectionLabel || 'home'}</a>
      </p>
    )}
  </article>

  {sectionPosts.length > 0 && (
    <section class="container section-list">
      <div class="section-head">
        <p class="eyebrow">In this section</p>
        <h2>{sectionLabel || 'Latest posts'} <span class="count">{sectionPosts.length}</span></h2>
      </div>
      <div class="grid">
        {sectionPosts.map((p) => <PostCard {...toCard(p)} />)}
      </div>
    </section>
  )}
</BaseLayout>
)}

<style>
  .container { padding-block: 2.5rem 1rem; }
  .back { max-width: var(--measure); margin: 2.5rem auto 0; }
  .back a { font-weight: 600; }

  /* Walk posts: article left, route panel right. */
  .walk-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 2.5rem;
    align-items: start;
  }
  .walk-prose { max-width: none; margin-inline: 0; min-width: 0; }
  @media (max-width: 899px) {
    /* minmax(0, …) prevents wide children (galleries) from blowing out the grid */
    .walk-layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
  }

  .section-list { padding-block: 1.5rem 3.5rem; }
  .section-head { margin-bottom: 1.5rem; }
  .section-head h2 { display: flex; align-items: baseline; gap: 0.6rem; margin: 0.15rem 0 0; }
  .section-head .count {
    font-size: 0.85rem;
    font-weight: 600;
    color: #05230a;
    background: var(--green);
    padding: 0.1em 0.6em;
    border-radius: 999px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
</style>
