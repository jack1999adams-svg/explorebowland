---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleHero from '../components/ArticleHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Tile from '../components/Tile.astro';
import { getPosts } from '../lib/content';
import { abs, breadcrumbs } from '../lib/schema.mjs';

const path = '/local-information/';
const title = 'Local Information';
const description =
  'Places of interest across the Forest of Bowland — castles, sculpture, farm parks, forests, stargazing and more, each a great day out in the area.';
const heroImg =
  'https://media.explorebowland.co.uk/wp-content/uploads/2019/05/Clitheroe-Castle.jpg';
const FALLBACK =
  'https://media.explorebowland.co.uk/wp-content/uploads/2020/10/Longridge-Fell-sunrise.jpg';

// Curated "places of interest". Each links to its own page (repo) or post
// (portal); image + current URL are resolved from the collections at build so
// they stay correct even as post URLs change.
const PLACES = [
  { title: 'Andy Goldsworthy Clougha Sculpture', page: '/andy-goldsworthy-sculpure-clougha/' },
  { title: 'Beacon Fell', page: '/beacon-fell-2/' },
  { title: 'Bowland Wild Boar Park', page: '/bowland-wild-boar-park/' },
  { title: 'Brock Bottom', page: '/brock-bottom/' },
  { title: 'Clitheroe Castle & Museum', page: '/clitheroe-castle/' },
  { title: 'Cobble Hey Farm & Gardens', page: '/cobble-hey-farm-gardens/' },
  { title: "Cromwell's Bridge", page: '/cromwells-bridge/' },
  { title: 'Eat, Drink & Sleep', page: '/eat-drink-sleep/' },
  { title: 'Gisburn Forest', page: '/gisburn-forest/' },
  { title: 'Gisburn Forest Bike Trails', page: '/gisburn-forest-bike-trails/' },
  { title: 'Pendle Ski Club', page: '/pendle-ski-club/' },
  { title: 'Sawley Abbey', page: '/sawley-abbey/' },
  { title: 'Singing Ringing Tree', page: '/singing-ringing-tree/' },
  { title: 'Stargazing', page: '/stargazing/' },
  { title: 'Trough of Bowland', postSlug: 'trough-of-bowland' },
  { title: 'Longridge Fell Cycling', postSlug: 'longridge-fell-cycling' },
  { title: 'Waterfalls', postSlug: 'lancashire-waterfalls' },
  { title: 'Camping', postSlug: 'camping' },
];

const pageHero = new Map((await getCollection('pages')).map((e) => [e.data.path, e.data.hero]));
const postBySlug = new Map(
  (await getPosts()).map((p) => [p.data.path.replace(/\/$/, '').split('/').pop(), p.data]),
);

const cards = PLACES.map((pl) => {
  if (pl.page) {
    return { title: pl.title, href: pl.page, image: pageHero.get(pl.page) || FALLBACK };
  }
  const post = postBySlug.get(pl.postSlug);
  if (!post) return null; // post retired in the portal — drop the card
  return { title: pl.title, href: post.path, image: post.hero || FALLBACK };
}).filter(Boolean);

const crumbs = [
  { name: 'Home', url: abs('/') },
  { name: title, url: abs(path) },
];
const jsonLd = [breadcrumbs(crumbs)];
---

<BaseLayout title={title} description={description} path={path} image={heroImg} jsonLd={jsonLd}>
  <ArticleHero title={title} hero={heroImg} heroAlt="Clitheroe Castle" />

  <section class="container intro">
    <Breadcrumbs crumbs={crumbs} />
    <p class="lead">
      Beyond the walks, the Forest of Bowland is full of places worth a visit —
      historic castles and abbeys, farm parks and forests, sculpture trails and
      some of the darkest skies in England for stargazing.
    </p>
  </section>

  <section class="container grid-wrap">
    <div class="places-grid">
      {cards.map((c) => <Tile href={c.href} title={c.title} image={c.image} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: 2.5rem 0.5rem; }
  .intro .lead {
    max-width: var(--measure);
    color: var(--ink-soft);
    font-size: var(--step-1);
    margin: 0.5rem 0 0;
  }
  .grid-wrap { padding-block: 1.5rem 3.5rem; }
  .places-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }
</style>
