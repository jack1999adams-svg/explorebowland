---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Baked preview template for portal-managed PAGES. The portal substitutes
// {{NOVA_*}} with the draft page and serves it behind the login. v1 renders the
// standard page layout for any template (title + hero + body).
---

<BaseLayout title={'{{NOVA_TITLE}}'} description={'{{NOVA_DESCRIPTION}}'} path="/nova-preview/page-default/" noindex>
  <header class="np-head has-image">
    <img class="np-hero-img" src={'{{NOVA_IMAGE}}'} alt={'{{NOVA_IMAGE_ALT}}'} width="1600" height="720" />
    <div class="np-scrim"></div>
    <div class="container"><h1>{'{{NOVA_TITLE}}'}</h1></div>
  </header>
  <article class="container np-page">
    <div class="prose"><Fragment set:html={'{{NOVA_BODY}}'} /></div>
  </article>
</BaseLayout>

<style>
  .np-head.has-image { position: relative; min-height: clamp(280px, 40vh, 460px); display: flex; align-items: flex-end; overflow: hidden; }
  .np-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .np-scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,29,57,.82), rgba(0,29,57,.15) 60%, rgba(0,29,57,.05)); }
  .np-head .container { position: relative; padding-block: 2rem; }
  .np-head h1 { color: #fff; font-size: var(--step-4, 2.4rem); margin: 0; max-width: 22ch; }
  .np-page { padding-block: 2.5rem 3.5rem; }
</style>
