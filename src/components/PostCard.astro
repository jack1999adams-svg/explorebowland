---
interface Props {
  href: string;
  title: string;
  description?: string;
  hero?: string;
  heroAlt?: string;
  categories?: string[];
  pubDate?: Date;
  featured?: boolean;
}
const { href, title, description = '', hero, heroAlt = '', categories = [], pubDate, featured = false } = Astro.props;
const dateStr = pubDate
  ? new Date(pubDate).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })
  : null;
---

<article class:list={['card', { featured }]}>
  <a href={href} class="media" tabindex="-1" aria-hidden="true">
    {hero ? (
      <img src={hero} alt={heroAlt} loading="lazy" width="800" height="600" />
    ) : (
      <div class="placeholder" aria-hidden="true">▲</div>
    )}
  </a>
  <div class="body">
    {categories[0] && <span class="eyebrow">{categories[0]}</span>}
    <h3><a href={href}>{title}</a></h3>
    {description && <p class="excerpt">{description}</p>}
    {dateStr && <p class="date">{dateStr}</p>}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .media { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-3); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .card:hover .media img { transform: scale(1.05); }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--green);
    font-size: 2rem;
    background: var(--paper-3);
  }
  .body { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: 0.4rem; }
  h3 { margin: 0; font-size: var(--step-1); }
  h3 a { color: var(--navy); text-decoration: none; }
  h3 a:hover { color: var(--green-dark); }
  .excerpt { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }
  .date { margin: 0.2rem 0 0; color: var(--ink-soft); font-size: var(--step--1); }

  .card.featured { flex-direction: row; grid-column: 1 / -1; }
  .card.featured .media { flex: 1 1 55%; aspect-ratio: 16 / 10; }
  .card.featured .body { flex: 1 1 45%; justify-content: center; padding: 2rem; }
  .card.featured h3 { font-size: var(--step-2); }
  @media (max-width: 720px) {
    .card.featured { flex-direction: column; }
    .card.featured .media { aspect-ratio: 4 / 3; }
  }
</style>
