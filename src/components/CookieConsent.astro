---
// Lightweight, dependency-free cookie consent manager wired to Google Consent
// Mode v2. The consent *default* (all denied) is set in BaseLayout's <head>
// before any tags load; this component collects the user's choice, persists it,
// and emits `gtag('consent','update', …)`. Essential storage is always granted.
//
// Categories -> Consent Mode signals:
//   analytics  -> analytics_storage
//   marketing  -> ad_storage, ad_user_data, ad_personalization, personalization_storage
//
// Reopen from anywhere with a `data-cookie-settings` element (see Footer) or
// window.ebCookieSettings().
---

<div id="cookie-consent" class="cc" role="dialog" aria-label="Cookie choices" aria-live="polite" hidden>
  <div class="cc-card">
    <h2 class="cc-title">Cookies on Explore Bowland</h2>
    <p class="cc-text">
      We use essential cookies to make the site work. With your permission we'd
      also use analytics to understand how the site is used. You can change your
      mind any time.
    </p>

    <div class="cc-prefs" hidden>
      <label class="cc-row cc-row--locked">
        <span><strong>Essential</strong><small>Required for the site to function.</small></span>
        <span class="cc-badge">Always on</span>
      </label>
      <label class="cc-row">
        <span><strong>Analytics</strong><small>Anonymous usage stats to improve the site.</small></span>
        <input type="checkbox" data-cat="analytics" />
      </label>
      <label class="cc-row">
        <span><strong>Marketing</strong><small>Personalised ads &amp; measurement.</small></span>
        <input type="checkbox" data-cat="marketing" />
      </label>
    </div>

    <div class="cc-actions">
      <button type="button" class="btn cc-accept" data-cc="accept">Accept all</button>
      <button type="button" class="btn btn--ghost cc-reject" data-cc="reject">Reject all</button>
      <button type="button" class="cc-link" data-cc="toggle-prefs" aria-expanded="false">Preferences</button>
      <button type="button" class="btn cc-save" data-cc="save" hidden>Save choices</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'eb_consent';
    var VERSION = 1;
    var MAX_AGE = 60 * 60 * 24 * 180; // 180 days

    var root = document.getElementById('cookie-consent');
    if (!root) return;
    var prefs = root.querySelector('.cc-prefs');
    var saveBtn = root.querySelector('[data-cc="save"]');
    var toggleBtn = root.querySelector('[data-cc="toggle-prefs"]');
    var boxes = root.querySelectorAll('input[data-cat]');

    function readCookie() {
      var m = document.cookie.match(/(?:^|; )eb_consent=([^;]+)/);
      if (!m) return null;
      try { return JSON.parse(decodeURIComponent(m[1])); } catch (e) { return null; }
    }
    function writeCookie(obj) {
      obj.v = VERSION;
      obj.ts = Math.floor(Date.now() / 1000);
      document.cookie =
        KEY + '=' + encodeURIComponent(JSON.stringify(obj)) +
        ';path=/;max-age=' + MAX_AGE + ';SameSite=Lax';
    }
    function updateConsent(c) {
      window.dataLayer = window.dataLayer || [];
      function g() { window.dataLayer.push(arguments); }
      g('consent', 'update', {
        analytics_storage: c.analytics ? 'granted' : 'denied',
        ad_storage: c.marketing ? 'granted' : 'denied',
        ad_user_data: c.marketing ? 'granted' : 'denied',
        ad_personalization: c.marketing ? 'granted' : 'denied',
        personalization_storage: c.marketing ? 'granted' : 'denied',
      });
    }
    function show() { root.hidden = false; }
    function hide() { root.hidden = true; }
    function openPrefs() {
      prefs.hidden = false;
      saveBtn.hidden = false;
      toggleBtn.setAttribute('aria-expanded', 'true');
      var saved = readCookie() || {};
      boxes.forEach(function (b) { b.checked = !!saved[b.dataset.cat]; });
    }
    function apply(c, persist) {
      if (persist) writeCookie(c);
      updateConsent(c);
      hide();
    }

    root.addEventListener('click', function (e) {
      var act = e.target.closest('[data-cc]');
      if (!act) return;
      var cmd = act.getAttribute('data-cc');
      if (cmd === 'accept') apply({ analytics: true, marketing: true }, true);
      else if (cmd === 'reject') apply({ analytics: false, marketing: false }, true);
      else if (cmd === 'toggle-prefs') openPrefs();
      else if (cmd === 'save') {
        var c = { analytics: false, marketing: false };
        boxes.forEach(function (b) { c[b.dataset.cat] = b.checked; });
        apply(c, true);
      }
    });

    // Reopen entry points
    function reopen() { openPrefs(); show(); }
    window.ebCookieSettings = reopen;
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-cookie-settings]')) { e.preventDefault(); reopen(); }
    });

    // First visit -> show banner. Returning visitor -> re-apply saved choice silently.
    var existing = readCookie();
    if (!existing || existing.v !== VERSION) show();
    else updateConsent(existing);
  })();
</script>

<style>
  .cc {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 60;
    max-width: min(30rem, calc(100vw - 2rem));
  }
  .cc-card {
    background: #fff;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.25rem 1.35rem 1.1rem;
    border-top: 4px solid var(--green);
  }
  .cc-title { font-size: 1.05rem; margin: 0 0 0.35rem; color: var(--navy); }
  .cc-text { font-size: 0.9rem; line-height: 1.5; color: var(--ink-soft); margin: 0 0 0.9rem; }

  .cc-prefs { margin: 0 0 0.9rem; border-top: 1px solid var(--line); }
  .cc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
  }
  .cc-row--locked { cursor: default; }
  .cc-row span:first-child { display: flex; flex-direction: column; }
  .cc-row strong { font-size: 0.9rem; color: var(--navy); }
  .cc-row small { font-size: 0.8rem; color: var(--ink-soft); }
  .cc-row input[type='checkbox'] { width: 1.15rem; height: 1.15rem; accent-color: var(--green); flex: none; }
  .cc-badge {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--green-dark);
    background: var(--paper-3);
    padding: 0.2em 0.6em;
    border-radius: 999px;
    white-space: nowrap;
  }

  .cc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .cc .btn { font-size: 0.88rem; padding: 0.55em 1.1em; cursor: pointer; border: 0; }
  .cc .btn--ghost { border: 1.5px solid var(--line); }
  .cc-link {
    background: none;
    border: 0;
    color: var(--green-ink);
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    padding: 0.55em 0.4em;
    margin-left: auto;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cc-link:hover { color: var(--green-dark); }

  @media (prefers-reduced-motion: no-preference) {
    .cc { animation: cc-in 0.28s ease-out both; }
    @keyframes cc-in { from { opacity: 0; transform: translateY(8px); } }
  }
  @media (max-width: 480px) {
    .cc { left: 0.5rem; right: 0.5rem; bottom: 0.5rem; max-width: none; }
    .cc-link { margin-left: 0; }
  }
</style>
