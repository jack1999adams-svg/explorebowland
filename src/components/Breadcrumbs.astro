---
// Visible breadcrumb trail. Takes the same { name, url } crumbs used to build
// the BreadcrumbList JSON-LD, so the on-page trail and the markup never drift.
// The last crumb is the current page and is rendered as plain text.
interface Crumb {
  name: string;
  url: string;
}
interface Props {
  crumbs?: Crumb[];
}
const { crumbs = [] } = Astro.props;
const items = crumbs.filter((c) => c && c.name);
---
{items.length > 1 && (
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      {items.map((c, i) =>
        i === items.length - 1 ? (
          <li><span aria-current="page">{c.name}</span></li>
        ) : (
          <li><a href={c.url}>{c.name}</a></li>
        ),
      )}
    </ol>
  </nav>
)}

<style>
  .breadcrumbs {
    font-size: 0.85rem;
    color: var(--ink-soft, #55606b);
    margin-bottom: 1.5rem;
  }
  .breadcrumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 0.5rem;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .breadcrumbs li + li::before {
    content: '/';
    color: var(--line, #c9d1d9);
    font-size: 0.85em;
  }
  .breadcrumbs a {
    color: var(--ink-soft, #55606b);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--green, #2f7d32);
    text-decoration: underline;
  }
  .breadcrumbs [aria-current='page'] {
    color: var(--ink, #1a1f24);
    font-weight: 600;
    /* keep long current titles from forcing horizontal scroll on mobile */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: min(60vw, 42ch);
  }
</style>
