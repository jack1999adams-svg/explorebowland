---
const nav = [
  { label: 'Bowland Walks', href: '/forest-of-bowland-walks/' },
  { label: 'Other Walks', href: '/forest-of-bowland/other-walks/' },
  { label: 'Things to Do', href: '/things-to-do/' },
  { label: 'Towns & Villages', href: '/things-to-do/towns-and-villages/' },
  { label: 'Photos', href: '/forest-of-bowland-photos/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/get-in-touch/' },
];
const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="Explore Bowland — home">
      <img src="/logo.png" alt="Explore Bowland" width="720" height="268" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: here === item.href }]}
          aria-current={here === item.href ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 3px solid var(--green);
    box-shadow: 0 1px 0 rgba(0, 29, 57, 0.04);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
  }
  .brand { display: inline-flex; align-items: center; }
  .brand img {
    height: 46px;
    width: auto;
    display: block;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.35rem;
    align-items: center;
  }
  .nav-link {
    color: var(--navy);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.5rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-link:hover { background: var(--paper-3); color: var(--green-dark); }
  .nav-link.active { background: var(--green); color: #05230a; font-weight: 600; }

  .nav-toggle, .burger { display: none; }
  @media (max-width: 900px) {
    .burger {
      display: inline-flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 8px;
    }
    .burger span {
      width: 24px;
      height: 2px;
      background: var(--navy);
      border-radius: 2px;
    }
    .nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      padding: 0.5rem;
      border-bottom: 3px solid var(--green);
      box-shadow: var(--shadow);
    }
    .nav-toggle:checked ~ .nav { display: flex; }
    .nav-link { padding: 0.8rem 1rem; border-radius: 8px; }
  }
  @media (max-width: 480px) {
    .brand img { height: 40px; }
    .bar { min-height: 64px; }
  }
</style>
