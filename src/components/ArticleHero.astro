---
interface Props {
  title: string;
  hero?: string;
  heroAlt?: string;
  pubDate?: Date;
  categories?: string[];
}
const { title, hero, heroAlt = '', pubDate, categories = [] } = Astro.props;
const dateStr = pubDate
  ? new Date(pubDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---

{hero ? (
  <header class="hero has-image">
    <img src={hero} alt={heroAlt} class="hero-bg" loading="eager" fetchpriority="high" width="1600" height="900" />
    <div class="scrim"></div>
    <div class="container hero-inner">
      {categories.length > 0 && (
        <p class="cats">{categories.map((c) => <span class="tag tag--on-dark">{c}</span>)}</p>
      )}
      <h1>{title}</h1>
      {dateStr && <p class="meta">{dateStr}</p>}
    </div>
  </header>
) : (
  <header class="hero plain">
    <div class="container hero-inner">
      {categories.length > 0 && (
        <p class="cats">{categories.map((c) => <span class="tag">{c}</span>)}</p>
      )}
      <h1>{title}</h1>
      {dateStr && <p class="meta">{dateStr}</p>}
    </div>
  </header>
)}

<style>
  .hero { position: relative; }
  .hero.has-image {
    min-height: clamp(320px, 46vh, 520px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 29, 57, 0.85) 0%, rgba(0, 29, 57, 0.3) 45%, rgba(0, 29, 57, 0.1) 100%);
  }
  .has-image .hero-inner { position: relative; padding-block: 2.5rem; color: #fff; }
  .has-image h1 { color: #fff; max-width: 20ch; }
  .has-image .meta { color: #d6e2ec; }

  .hero.plain {
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
  }
  .plain .hero-inner { padding-block: 3rem 2rem; }

  h1 { font-size: var(--step-4); margin: 0.3em 0 0.2em; }
  .meta { margin: 0.4rem 0 0; font-size: var(--step--1); }
  .cats { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; }
  .tag--on-dark {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    backdrop-filter: blur(4px);
  }
</style>
