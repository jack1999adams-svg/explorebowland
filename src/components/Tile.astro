---
interface Props {
  href: string;
  title: string;
  image?: string;
  eyebrow?: string;
  count?: number;
  desc?: string;
  tall?: boolean;
}
const { href, title, image, eyebrow, count, desc, tall = false } = Astro.props;
---

<a href={href} class:list={['tile', { tall }]}>
  {image && <img src={image} alt="" class="bg" loading="lazy" />}
  <div class="scrim"></div>
  <div class="content">
    {eyebrow && <span class="eyebrow eyebrow--light">{eyebrow}</span>}
    <h3>{title}{count != null && <span class="count">{count}</span>}</h3>
    {desc && <p>{desc}</p>}
    <span class="go" aria-hidden="true">Explore →</span>
  </div>
</a>

<style>
  .tile {
    position: relative;
    display: block;
    min-height: 220px;
    border-radius: var(--radius);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: var(--navy);
    box-shadow: var(--shadow-sm);
  }
  .tile.tall { min-height: 320px; }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    transition: transform 0.5s ease;
  }
  .tile:hover .bg { transform: scale(1.06); }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(0, 29, 57, 0.9) 0%, rgba(0, 29, 57, 0.45) 45%, rgba(0, 29, 57, 0.15) 100%);
  }
  .content {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 1.25rem 1.35rem;
  }
  h3 {
    color: #fff;
    margin: 0.25rem 0 0.15rem;
    font-size: var(--step-1);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .count {
    font-size: 0.9rem;
    font-weight: 600;
    color: #05230a;
    background: var(--green);
    padding: 0.1em 0.55em;
    border-radius: 999px;
  }
  .content p { margin: 0.1rem 0 0.4rem; color: #dbe4ec; font-size: 0.92rem; }
  .go {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--green);
    opacity: 0.9;
    transition: transform 0.2s ease;
    display: inline-block;
  }
  .tile:hover .go { transform: translateX(4px); }
</style>
